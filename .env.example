# GitHub token (optional but recommended: raises rate limit to 5000/hr).
# Create a classic PAT with public_repo scope (or fine-grained read-only on the repo).
GITHUB_TOKEN=

# Telegram bot for alerts. Setup:
#   1. In Telegram, message @BotFather -> /newbot -> copy the token below.
#   2. Send any message to your new bot.
#   3. Get your chat id: open https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
# When both are set, a default Telegram channel is created on first run; add monitors in the UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
